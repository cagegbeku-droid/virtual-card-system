# ==============================================================
# Coratech Global — Virtual Card & MoMo System Environment Config
# ==============================================================

ENVIRONMENT=production
PORT=8000

# Authentication & Session Security
JWT_SECRET_KEY=replace-with-a-random-64-character-production-secret-key-2026

# ==============================================================
# Neon Serverless PostgreSQL Database (https://neon.tech)
# Replace with your Neon connection string:
# ==============================================================
DATABASE_URL=postgresql://coratech_owner:your_neon_password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==============================================================
# Mobile Money Payment Rail (Paystack Ghana)
# Get keys from: https://dashboard.paystack.com/#/settings/developer
# ==============================================================
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# ==============================================================
# Virtual Card Issuing BaaS Partner (Bridgecard / Flutterwave)
# Get keys from: https://dashboard.bridgecard.co or Flutterwave
# ==============================================================
BRIDGECARD_API_KEY=your_bridgecard_api_key_here
BRIDGECARD_SECRET_KEY=your_bridgecard_secret_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here

# ==============================================================
# SMS OTP Gateway for Ghana (Arkesel SMS)
# Get keys from: https://arkesel.com/
# ==============================================================
ARKESEL_API_KEY=your_arkesel_api_key_here
